# Keep directory markers; do not commit raw/processed data by default.
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep
/outputs/*
!/outputs/.gitkeep
.ipynb_checkpoints/
*.log
